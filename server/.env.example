DATABASE_URL="postgresql://postgres:password@localhost:5432/finmodel_db?schema=public"
PORT=5000
JWT_SECRET="your-jwt-secret-key"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
SUPER_ADMIN_TELEGRAM_ID="your-telegram-id"
UPLOAD_DIR="./uploads"
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# AI yordamchi (Google Gemini). Kalit faqat serverda saqlanadi; GEMINI_MODEL ixtiyoriy (bo'sh bo'lsa standart model).
GEMINI_API_KEY=
GEMINI_MODEL=

# Bildirishnomalar. TELEGRAM_BOT_USERNAME — bot nomi "@" siz (Telegram'ni bog'lash havolasi uchun).
TELEGRAM_BOT_USERNAME=
# Android push (Firebase): service account JSON satr ko'rinishida YOKI fayl yo'li (batafsil: docs/FIREBASE_SETUP.md)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
